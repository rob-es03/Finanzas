# Plantilla de variables de entorno. Copia a `.env` (ignorado por Git) y rellena.
# NUNCA escribas aquí valores reales: este archivo se publica.

# --- Supabase (proyecto: ujalaluhmtwevqhnzivo) ---
# URL pública del proyecto
SUPABASE_URL=https://ujalaluhmtwevqhnzivo.supabase.co
# Clave anónima (pública, protegida por RLS). Panel > Settings > API
SUPABASE_ANON_KEY=
# Clave de servicio: SOLO para herramientas locales y Edge Functions.
# Jamás en el cliente Angular ni en este repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Token de acceso personal para la CLI / MCP de Supabase (sbp_...)
SUPABASE_ACCESS_TOKEN=

# --- Google OAuth (Supabase Auth) ---
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# --- Firebase Cloud Messaging (solo mensajería) ---
# google-services.json se coloca en apps/mobile/android/app/ y está en .gitignore
FCM_SENDER_ID=

# --- Firma Android (release) ---
# Los valores reales van en apps/mobile/android/keystore.properties (ignorado)
ANDROID_KEYSTORE_PATH=
ANDROID_KEY_ALIAS=
